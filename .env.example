# Set either TMDB API Key (v3) or API Read Access Token. Server only.
TMDB_API_KEY=
TMDB_READ_TOKEN=

# Supabase (Project Settings → API). The anon/publishable key is safe in the browser; RLS enforces access.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Tests only (creates/deletes throwaway users). Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Enable only behind an ingress that overwrites X-Forwarded-For.
# Otherwise configure per-client rate limiting at the deployment gateway.
API_TRUST_PROXY=0
