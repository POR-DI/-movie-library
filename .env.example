# Set either TMDB API Key (v3) or API Read Access Token. Server only.
TMDB_API_KEY=
TMDB_READ_TOKEN=
PORT=3001

# Supabase (Project Settings → API). The anon/publishable key is safe in the browser; RLS enforces access.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Tests only (creates/deletes throwaway users). Never prefix with VITE_.
SUPABASE_SERVICE_ROLE_KEY=
